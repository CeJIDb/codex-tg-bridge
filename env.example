# === Telegram ===
# Токен от @BotFather. Никогда не коммитить (этот файл — только шаблон).
BOT_TOKEN=<PASTE_BOT_TOKEN_HERE>

# Список разрешённых Telegram user id через запятую (узнать через @userinfobot).
# Всё, что не из списка, бот молча игнорирует.
ALLOWED_USER_IDS=<YOUR_TELEGRAM_ID>

# === Codex ===
# Абсолютный путь к графовому репозиторию, который бот будет опрашивать.
GRAPH_REPO_PATH=/home/cejidb/cursor/marine-requirements-graph

# Модель Codex (по умолчанию берётся из ~/.codex/config.toml).
# CODEX_MODEL=gpt-5.5

# Уровень рассуждений Codex для запросов от бота: minimal | low | medium | high | xhigh.
# Дефолт medium — баланс цена/качество для графовых запросов.
# high — для сравнений и многошаговых выводов; xhigh почти всегда переплата.
CODEX_EFFORT=medium

# Таймаут одного запроса к Codex в миллисекундах (5 мин).
CODEX_TIMEOUT_MS=300000

# Если задан — в эту папку сохраняется сырой JSONL Codex'а на каждый запрос
# (для отладки парсера токенов). По умолчанию выключено.
# CODEX_DEBUG_DIR=/tmp/codex-jsonl
